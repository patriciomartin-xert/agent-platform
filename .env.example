# OmniJourney AI Environment Configuration

# Server Port
PORT=3000

# Google AI Studio API Key (Gemini)
# Omit or leave empty to run the platform in automatic simulated mode (great for zero-setup demos!)
GEMINI_API_KEY=

# Google Sheets CMS configuration (Google Service Account key JSON file content)
# Omit to fallback to our Sheets-Simulator JSON DB (mi-empresa, clinica-dental)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Salesforce CRM OAuth and Sandbox Integration details
# Leave defaults to use our simulated Salesforce console log tracking
SALESFORCE_CLIENT_ID=MOCK_SF_CLIENT_ID
SALESFORCE_CLIENT_SECRET=MOCK_SF_CLIENT_SECRET
SALESFORCE_USERNAME=MOCK_SF_USERNAME
SALESFORCE_PASSWORD=MOCK_SF_PASSWORD
