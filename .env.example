# ==============================================================================
# OPALO / GROK BOT ENTERPRISE CLONE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- ENTORNO Y OPERACIÓN ---
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=change-me-super-secret-hex-key-min-32-chars

# --- PROVEEDORES LLM & API KEYS ---
# OpenAI (GPT-4o, GPT-4o-mini, text-embedding-3-small)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Anthropic (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
# Google AI Studio (Gemini 1.5 Pro / Flash)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tavily Search API (Búsqueda web en tiempo real)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- BASE DE DATOS Y PERSISTENCIA (PostgreSQL + PgVector) ---
POSTGRES_USER=grok_admin
POSTGRES_PASSWORD=grok_secure_password_2026
POSTGRES_DB=grok_enterprise_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- CACHÉ Y PUB/SUB (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# --- SERVIDOR DE HERRAMIENTAS Y PLAYWRIGHT (MCP) ---
TOOLS_SERVER_HOST=tools-server
TOOLS_SERVER_PORT=8001
TOOLS_SERVER_URL=http://${TOOLS_SERVER_HOST}:${TOOLS_SERVER_PORT}
TOOLS_WORKSPACE_DIR=/workspace
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT_MS=30000

# --- HITL (HUMAN-IN-THE-LOOP) Y SEGURIDAD ---
CRITICAL_TOOLS_REQUIRE_APPROVAL=exec_command,delete_file,write_file,submit_payment_form
MAX_AUTONOMOUS_STEPS=25
MAX_VALIDATION_RETRIES=3

# --- FASTAPI BACKEND ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- FRONTEND CLIENT ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/agent
